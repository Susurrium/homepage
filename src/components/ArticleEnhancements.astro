<div
  class="article-reading-progress"
  role="progressbar"
  aria-label="文章阅读进度"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  data-reading-progress
>
  <span aria-hidden="true"></span>
</div>

<p class="sr-only" role="status" aria-live="polite" data-article-status></p>

<dialog class="article-lightbox" aria-label="图片预览" data-article-lightbox>
  <button type="button" class="lightbox-close focus-ring" aria-label="关闭图片预览" data-lightbox-close>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
  <figure>
    <img
      src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
      alt=""
      data-lightbox-image
    />
    <figcaption data-lightbox-caption hidden></figcaption>
  </figure>
</dialog>

<script>
  const articleRoot = document.querySelector<HTMLElement>('[data-article-root]');
  const articleContent = articleRoot?.querySelector<HTMLElement>('[data-article-content]');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const status = document.querySelector<HTMLElement>('[data-article-status]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let statusTimer: number | undefined;

  const announce = (message: string) => {
    if (!status) return;
    if (statusTimer !== undefined) window.clearTimeout(statusTimer);
    status.textContent = '';
    statusTimer = window.setTimeout(() => {
      status.textContent = message;
    }, 20);
  };

  const copyText = async (value: string) => {
    if (!navigator.clipboard) throw new Error('Clipboard API is unavailable');
    await navigator.clipboard.writeText(value);
  };

  if (articleRoot && articleContent) {
    const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
    const tocLinks = Array.from(articleRoot.querySelectorAll<HTMLAnchorElement>('[data-article-toc-link]'));
    const desktopToc = articleRoot.querySelector<HTMLElement>('[data-article-toc-desktop]');
    const headingIds = [...new Set(tocLinks.map((link) => link.dataset.headingId).filter((id): id is string => Boolean(id)))];
    const tocHeadings = headingIds
      .map((id) => document.getElementById(id))
      .filter((heading): heading is HTMLElement => Boolean(heading));
    let updateFrame: number | undefined;
    let activeHeadingId: string | undefined;

    const updateReadingState = () => {
      updateFrame = undefined;
      const headerOffset = (siteHeader?.offsetHeight ?? 0) + 24;

      if (progress) {
        const bounds = articleContent.getBoundingClientRect();
        const start = window.scrollY + bounds.top - headerOffset;
        const end = Math.max(start + 1, window.scrollY + bounds.bottom - window.innerHeight);
        const value = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
        const percentage = Math.round(value * 100);
        progress.style.setProperty('--reading-progress', String(value));
        progress.setAttribute('aria-valuenow', String(percentage));
      }

      if (tocHeadings.length > 0) {
        let activeId = tocHeadings[0].id;
        for (const heading of tocHeadings) {
          if (heading.getBoundingClientRect().top > headerOffset) break;
          activeId = heading.id;
        }

        if (activeId !== activeHeadingId) {
          activeHeadingId = activeId;
          tocLinks.forEach((link) => {
            if (link.dataset.headingId === activeId) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });

          const activeDesktopLink = tocLinks.find(
            (link) => link.dataset.headingId === activeId && Boolean(link.closest('[data-article-toc-desktop]'))
          );

          if (desktopToc && activeDesktopLink) {
            const containerBounds = desktopToc.getBoundingClientRect();
            const linkBounds = activeDesktopLink.getBoundingClientRect();
            const edgePadding = 8;

            if (linkBounds.top < containerBounds.top + edgePadding) {
              desktopToc.scrollTop -= containerBounds.top + edgePadding - linkBounds.top;
            } else if (linkBounds.bottom > containerBounds.bottom - edgePadding) {
              desktopToc.scrollTop += linkBounds.bottom - containerBounds.bottom + edgePadding;
            }
          }
        }
      }
    };

    const scheduleReadingStateUpdate = () => {
      if (updateFrame !== undefined) return;
      updateFrame = window.requestAnimationFrame(updateReadingState);
    };

    const handleViewportResize = () => {
      activeHeadingId = undefined;
      scheduleReadingStateUpdate();
    };

    window.addEventListener('scroll', scheduleReadingStateUpdate, { passive: true });
    window.addEventListener('resize', handleViewportResize);
    window.addEventListener('load', scheduleReadingStateUpdate, { once: true });
    articleContent.querySelectorAll('img').forEach((image) => {
      if (!image.complete) image.addEventListener('load', scheduleReadingStateUpdate, { once: true });
    });
    updateReadingState();

    const headings = articleContent.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]');
    headings.forEach((heading) => {
      if (heading.querySelector('[data-heading-anchor]')) return;

      const label = heading.textContent?.trim() || '此小节';
      if (!heading.hasAttribute('aria-label')) heading.setAttribute('aria-label', label);
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor focus-ring';
      anchor.href = `#${heading.id}`;
      anchor.textContent = '#';
      anchor.title = '复制此小节链接';
      anchor.setAttribute('aria-label', `复制此小节链接：${label}`);
      anchor.dataset.headingAnchor = '';
      heading.append(anchor);

      anchor.addEventListener('click', async (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();

        const url = new URL(window.location.href);
        url.hash = heading.id;
        heading.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
        window.history.replaceState(null, '', url);

        try {
          await copyText(url.href);
          anchor.classList.add('is-copied');
          anchor.textContent = '\u2713';
          anchor.setAttribute('aria-label', `已复制小节链接：${label}`);
          announce('小节链接已复制');
          window.setTimeout(() => {
            anchor.classList.remove('is-copied');
            anchor.textContent = '#';
            anchor.setAttribute('aria-label', `复制此小节链接：${label}`);
          }, 1600);
        } catch {
          announce('无法自动复制，请从地址栏复制链接');
        }
      });
    });

    const languageAliases: Record<string, string> = {
      bash: 'Bash',
      css: 'CSS',
      html: 'HTML',
      javascript: 'JavaScript',
      js: 'JavaScript',
      json: 'JSON',
      jsx: 'JSX',
      markdown: 'Markdown',
      md: 'Markdown',
      plaintext: 'Text',
      powershell: 'PowerShell',
      python: 'Python',
      py: 'Python',
      shell: 'Shell',
      sh: 'Shell',
      text: 'Text',
      ts: 'TypeScript',
      tsx: 'TSX',
      typescript: 'TypeScript',
      yaml: 'YAML',
      yml: 'YAML'
    };

    articleContent.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
      if (pre.closest('[data-code-block]')) return;
      const code = pre.querySelector<HTMLElement>('code');
      if (!code) return;

      const classLanguage = [...pre.classList, ...code.classList]
        .find((name) => name.startsWith('language-'))
        ?.replace('language-', '');
      const rawLanguage = (pre.dataset.language || code.dataset.language || classLanguage || 'text').toLowerCase();
      const language = languageAliases[rawLanguage] ?? rawLanguage.toUpperCase();

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      wrapper.dataset.codeBlock = '';

      const toolbar = document.createElement('div');
      toolbar.className = 'code-block-toolbar';

      const languageLabel = document.createElement('span');
      languageLabel.className = 'code-block-language';
      languageLabel.textContent = language;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'code-copy-button focus-ring';
      copyButton.textContent = '复制';
      copyButton.setAttribute('aria-label', `复制 ${language} 代码`);

      toolbar.append(languageLabel, copyButton);
      pre.before(wrapper);
      wrapper.append(toolbar, pre);

      copyButton.addEventListener('click', async () => {
        try {
          await copyText(code.textContent || '');
          copyButton.textContent = '已复制';
          copyButton.classList.add('is-copied');
          announce('代码已复制');
          window.setTimeout(() => {
            copyButton.textContent = '复制';
            copyButton.classList.remove('is-copied');
          }, 1600);
        } catch {
          copyButton.textContent = '复制失败';
          announce('代码复制失败');
          window.setTimeout(() => {
            copyButton.textContent = '复制';
          }, 1600);
        }
      });
    });

    const lightbox = document.querySelector<HTMLDialogElement>('[data-article-lightbox]');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxCaption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');
    const closeLightbox = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    let activeImage: HTMLImageElement | null = null;

    const supportsLightbox = Boolean(
      lightbox && lightboxImage && lightboxCaption && typeof lightbox.showModal === 'function'
    );

    const openImage = (image: HTMLImageElement) => {
      if (!supportsLightbox || !lightbox || !lightboxImage || !lightboxCaption) return;
      activeImage = image;
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      const figureCaption = image.closest('figure')?.querySelector('figcaption')?.textContent?.trim();
      const caption = figureCaption || '';
      lightboxCaption.textContent = caption;
      lightboxCaption.hidden = !caption;
      lightbox.showModal();
    };

    const zoomableImages = articleRoot.querySelectorAll<HTMLImageElement>('[data-article-image], [data-article-content] img');
    if (supportsLightbox) {
      zoomableImages.forEach((image) => {
        if (image.closest('a')) return;
        image.classList.add('article-zoomable-image');
        image.tabIndex = 0;
        image.setAttribute('role', 'button');
        image.setAttribute('aria-label', image.alt ? `查看大图：${image.alt}` : '查看文章大图');
        image.title = '点击查看大图';
        image.addEventListener('click', () => openImage(image));
        image.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openImage(image);
        });
      });

      closeLightbox?.addEventListener('click', () => lightbox?.close());
      lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
      lightbox?.addEventListener('close', () => {
        activeImage?.focus();
        activeImage = null;
      });
    }

    scheduleReadingStateUpdate();
  }
</script>

<style>
  .article-reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 3px;
    overflow: hidden;
    pointer-events: none;
  }

  .article-reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-3), var(--accent-2));
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 40%, transparent);
    transform: scaleX(var(--reading-progress, 0));
    transform-origin: left;
    will-change: transform;
  }

  :global([data-article-content] h2),
  :global([data-article-content] h3),
  :global([data-article-content] h4) {
    position: relative;
  }

  :global(.heading-anchor) {
    display: inline-flex;
    min-width: 1.75rem;
    min-height: 1.75rem;
    align-items: center;
    justify-content: center;
    margin-left: 0.25rem;
    border-radius: 0.25rem;
    color: var(--muted) !important;
    font-size: 0.8em;
    font-weight: 500;
    line-height: 1;
    text-decoration: none !important;
    opacity: 0;
    transform: translateY(-0.05em);
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  :global([data-article-content] :is(h2, h3, h4):hover .heading-anchor),
  :global(.heading-anchor:focus-visible),
  :global(.heading-anchor.is-copied) {
    color: var(--accent) !important;
    opacity: 1;
  }

  :global(.code-block) {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--code-text) 14%, transparent);
    border-radius: 0.5rem;
    background: var(--code-bg);
  }

  :global(.code-block-toolbar) {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--code-text) 14%, transparent);
    padding: 0.35rem 0.5rem 0.35rem 0.85rem;
    background: color-mix(in srgb, var(--code-bg) 92%, var(--code-text));
  }

  :global(.code-block-language) {
    color: color-mix(in srgb, var(--code-text) 68%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.code-copy-button) {
    min-height: 1.8rem;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--code-text) 18%, transparent);
    border-radius: 0.3rem;
    padding: 0.2rem 0.55rem;
    background: color-mix(in srgb, var(--code-text) 8%, transparent);
    color: color-mix(in srgb, var(--code-text) 80%, transparent);
    font-size: 0.75rem;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  :global(.code-copy-button:hover),
  :global(.code-copy-button:focus-visible),
  :global(.code-copy-button.is-copied) {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--code-text);
  }

  :global([data-code-block] pre) {
    margin: 0;
    border-radius: 0;
  }

  :global(.article-zoomable-image) {
    cursor: zoom-in;
    outline: none;
  }

  :global(.article-zoomable-image:focus-visible) {
    border-radius: 0.5rem;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 38%, transparent);
  }

  .article-lightbox {
    width: min(94vw, 90rem);
    max-width: none;
    max-height: 94vh;
    margin: auto;
    overflow: visible;
    border: 1px solid color-mix(in srgb, white 18%, transparent);
    border-radius: 0.75rem;
    padding: 0;
    background: #090a0c;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
    color: white;
  }

  .article-lightbox::backdrop {
    background: rgba(4, 5, 7, 0.82);
    backdrop-filter: blur(5px);
  }

  .article-lightbox figure {
    display: grid;
    place-items: center;
    margin: 0;
  }

  .article-lightbox img {
    max-width: 100%;
    max-height: calc(94vh - 4rem);
    object-fit: contain;
  }

  .article-lightbox figcaption {
    width: 100%;
    padding: 0.7rem 1rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.8125rem;
    text-align: center;
  }

  .lightbox-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(4, 5, 7, 0.72);
    color: white;
  }

  .lightbox-close:hover {
    background: rgba(30, 32, 36, 0.94);
  }

  .lightbox-close svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  @media (hover: none) {
    :global(.heading-anchor) {
      opacity: 0.72;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.heading-anchor),
    :global(.code-copy-button) {
      transition: none;
    }
  }
</style>
