---
import { withBase } from '../lib/url';

interface Props {
  class?: string;
  autoplay?: boolean;
  duration?: number;
  replay?: boolean;
  label?: string;
  image?: string;
}

const {
  class: className = '',
  autoplay = true,
  duration = 3200,
  replay = true,
  label = '动态手写签名',
  image = '/images/signature-ink.png',
} = Astro.props;

const signatureId = `signature-${Math.random().toString(36).slice(2, 9)}`;
const imageUrl = withBase(image);
---

<figure
  id={signatureId}
  class:list={['dynamic-signature', className]}
  data-autoplay={autoplay ? 'true' : 'false'}
  data-duration={duration}
  aria-label={label}
>
  <svg
    id={`${signatureId}-stage`}
    class="signature-stage"
    viewBox="0 0 2172 724"
    role="img"
    aria-labelledby={`${signatureId}-title`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={`${signatureId}-title`}>{label}</title>
    <defs>
      <mask id={`${signatureId}-reveal-mask`} maskUnits="userSpaceOnUse">
        <rect width="2172" height="724" fill="black" />
        <rect class="signature-sweep-rect" x="-72" y="-36" width="2316" height="796" fill="white" />
      </mask>
    </defs>

    <image class="signature-ink signature-ink-final" href={imageUrl} width="2172" height="724" />
    <image
      class="signature-ink signature-ink-reveal"
      href={imageUrl}
      width="2172"
      height="724"
      mask={`url(#${signatureId}-reveal-mask)`}
    />
  </svg>

  {
    replay && (
      <button
        class="signature-replay focus-ring"
        type="button"
        aria-label="重新播放签名动画"
        aria-controls={`${signatureId}-stage`}
      >
        重播签名
      </button>
    )
  }
</figure>

<script>
  const setupSignature = (root: HTMLElement) => {
    root.classList.add('is-ready');
    const duration = Number(root.dataset.duration || 3200);
    const autoplay = root.dataset.autoplay !== 'false';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sweepRect = root.querySelector<SVGRectElement>('.signature-sweep-rect');
    const replay = root.querySelector<HTMLButtonElement>('.signature-replay');
    let completeTimer: number | undefined;

    const prepare = () => {
      if (!sweepRect) return;
      window.clearTimeout(completeTimer);
      root.classList.remove('is-writing', 'is-complete');
      sweepRect.style.animation = 'none';
      sweepRect.style.transform = 'scaleX(0)';
      sweepRect.getBoundingClientRect();
    };

    const complete = () => {
      root.classList.remove('is-writing');
      root.classList.add('is-complete');
    };

    const play = () => {
      if (!sweepRect || reduceMotion) {
        complete();
        return;
      }

      prepare();
      root.classList.add('is-writing');
      sweepRect.style.animation = `signature-sweep ${duration}ms cubic-bezier(.42,.02,.18,1) forwards`;
      completeTimer = window.setTimeout(complete, duration + 160);
    };

    prepare();
    if (autoplay) {
      requestAnimationFrame(play);
    } else {
      complete();
    }

    replay?.addEventListener('click', play);
  };

  document.querySelectorAll<HTMLElement>('.dynamic-signature').forEach(setupSignature);
</script>

<style>
  .dynamic-signature {
    position: relative;
    width: min(720px, 100%);
    margin: 0;
  }

  .signature-stage {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .signature-ink {
    filter: none;
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.dark) .signature-ink {
    filter: invert(1);
  }

  .signature-ink-final {
    opacity: 1;
    transition: opacity 220ms ease;
  }

  .signature-ink-reveal {
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .signature-sweep-rect {
    transform: scaleX(1);
    transform-box: fill-box;
    transform-origin: left center;
  }

  .dynamic-signature.is-ready .signature-ink-final {
    opacity: 0;
  }

  .dynamic-signature.is-ready .signature-ink-reveal {
    opacity: 1;
  }

  .dynamic-signature.is-ready .signature-sweep-rect {
    transform: scaleX(0);
  }

  .dynamic-signature.is-complete .signature-ink-final {
    opacity: 1;
  }

  .dynamic-signature.is-complete .signature-ink-reveal {
    opacity: 0;
  }

  .signature-replay {
    display: none;
    position: absolute;
    right: 0;
    bottom: 2%;
    border: 1px solid var(--line);
    border-radius: 6px;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    touch-action: manipulation;
    transition:
      opacity 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .dynamic-signature.is-ready .signature-replay {
    display: block;
  }

  .dynamic-signature:hover .signature-replay,
  .signature-replay:focus-visible {
    opacity: 1;
  }

  .signature-replay:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .signature-replay:active {
    border-color: var(--accent);
    color: var(--text);
  }

  @media (hover: none), (pointer: coarse) {
    .signature-replay {
      opacity: 1;
    }
  }

  @keyframes signature-sweep {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-ink-final {
      opacity: 1;
    }

    .signature-ink-reveal,
    .dynamic-signature.is-ready .signature-replay {
      display: none;
    }
  }
</style>
