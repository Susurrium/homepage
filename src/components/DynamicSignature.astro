---
interface Props {
  class?: string;
  autoplay?: boolean;
  duration?: number;
  replay?: boolean;
  label?: string;
}

const {
  class: className = '',
  autoplay = true,
  duration = 5200,
  replay = true,
  label = '动态手写签名',
} = Astro.props;

const signatureId = `signature-${Math.random().toString(36).slice(2, 9)}`;
---

<figure
  id={signatureId}
  class:list={['dynamic-signature', className]}
  data-autoplay={autoplay ? 'true' : 'false'}
  data-duration={duration}
  aria-label={label}
>
  <svg
    class="signature-stage"
    viewBox="0 0 2172 724"
    role="img"
    aria-labelledby={`${signatureId}-title`}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id={`${signatureId}-title`}>{label}</title>
    <defs>
      <filter id={`${signatureId}-brush-edge`} x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="9" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.8" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <mask id={`${signatureId}-write-mask`} maskUnits="userSpaceOnUse">
        <rect width="2172" height="724" fill="black" />
        <g class="signature-mask-strokes" filter={`url(#${signatureId}-brush-edge)`}>
          <path
            class="signature-stroke"
            data-weight="primary"
            data-delay="0"
            data-part="initial"
            d="M 581 57 C 470 60 314 126 211 216 C 144 275 112 336 141 382 C 173 432 258 442 389 434 C 500 428 594 448 622 500 C 648 550 592 589 474 623 C 351 660 174 683 92 646 C 58 631 69 591 127 539 C 213 461 348 411 507 385"
          />
          <path
            class="signature-stroke"
            data-weight="primary"
            data-delay="0.13"
            data-part="initial"
            d="M 572 246 C 660 198 759 95 720 55 C 681 14 540 52 405 115 C 281 174 164 250 137 333"
          />
          <path
            class="signature-stroke"
            data-weight="word"
            data-delay="0.31"
            data-part="body"
            d="M 584 385 C 614 348 661 302 696 287 C 668 341 632 393 654 421 C 678 447 728 392 773 342 C 754 398 751 440 784 444 C 827 449 897 359 929 307 C 886 385 883 431 916 434 C 956 438 1006 360 1053 292 C 1023 353 993 410 1022 420 C 1062 434 1119 349 1164 289 C 1132 349 1104 405 1138 411 C 1178 418 1230 337 1277 282 C 1246 340 1222 394 1255 401 C 1296 409 1352 329 1394 284 C 1369 329 1357 373 1389 381 C 1425 390 1465 318 1501 279 C 1478 333 1480 373 1525 384 C 1582 398 1697 354 1880 302 C 1959 279 2043 260 2076 264"
          />
          <path
            class="signature-stroke"
            data-weight="dot"
            data-delay="0.58"
            data-part="dot"
            d="M 1331 157 C 1301 170 1275 191 1265 207"
          />
          <path
            class="signature-stroke"
            data-weight="underline"
            data-delay="0.63"
            data-part="underline"
            d="M 624 592 C 879 494 1135 436 1406 417 C 1534 408 1636 414 1697 425"
          />
          <path
            class="signature-stroke"
            data-weight="flourish"
            data-delay="0.76"
            data-part="flourish"
            d="M 1681 516 C 1768 427 1871 338 2048 253 C 1992 284 1878 310 1702 362"
          />
          <path
            class="signature-stroke"
            data-weight="dot"
            data-delay="0.93"
            data-part="dot"
            d="M 2092 219 C 2107 206 2121 206 2116 221 C 2112 233 2094 236 2088 230"
          />
        </g>
      </mask>
    </defs>

    <image
      class="signature-ink signature-ink-final"
      href="/images/signature-ink.png"
      width="2172"
      height="724"
      decoding="async"
    />
    <image
      class="signature-ink signature-ink-reveal"
      href="/images/signature-ink.png"
      width="2172"
      height="724"
      decoding="async"
      mask={`url(#${signatureId}-write-mask)`}
    />
  </svg>

  {
    replay && (
      <button class="signature-replay focus-ring" type="button" aria-label="重新播放签名动画">
        重播
      </button>
    )
  }
</figure>

<script>
  const setupSignature = (root: HTMLElement) => {
    const duration = Number(root.dataset.duration || 5200);
    const autoplay = root.dataset.autoplay !== 'false';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const strokes = Array.from(root.querySelectorAll<SVGPathElement>('.signature-stroke'));
    const replay = root.querySelector<HTMLButtonElement>('.signature-replay');

    const weights: Record<string, number> = {
      primary: 118,
      word: 92,
      underline: 54,
      flourish: 48,
      dot: 34,
    };

    const prepare = () => {
      root.classList.remove('is-complete');
      strokes.forEach((stroke) => {
        const length = stroke.getTotalLength();
        stroke.style.strokeWidth = `${weights[stroke.dataset.weight || 'word'] || 84}`;
        stroke.style.strokeDasharray = `${length}`;
        stroke.style.strokeDashoffset = `${length}`;
        stroke.style.animation = 'none';
        stroke.getBoundingClientRect();
      });
    };

    const play = () => {
      if (reduceMotion) {
        root.classList.add('is-complete');
        return;
      }

      prepare();
      root.classList.add('is-writing');
      strokes.forEach((stroke) => {
        const delay = Number(stroke.dataset.delay || 0) * duration;
        const part = stroke.dataset.part || 'body';
        const length = stroke.getTotalLength();
        const speedFactor = part === 'initial' ? 0.3 : part === 'body' ? 0.34 : part === 'underline' ? 0.21 : part === 'flourish' ? 0.19 : 0.08;
        const strokeDuration = Math.max(240, duration * speedFactor);

        stroke.style.strokeDasharray = `${length}`;
        stroke.style.strokeDashoffset = `${length}`;
        stroke.style.animation = `signature-write ${strokeDuration}ms cubic-bezier(.52,.02,.18,1) ${delay}ms forwards`;
      });

      window.setTimeout(() => {
        root.classList.remove('is-writing');
        root.classList.add('is-complete');
      }, duration + 180);
    };

    prepare();
    if (autoplay) {
      requestAnimationFrame(play);
    } else {
      root.classList.add('is-complete');
    }

    replay?.addEventListener('click', play);
  };

  document.querySelectorAll<HTMLElement>('.dynamic-signature').forEach(setupSignature);
</script>

<style>
  .dynamic-signature {
    position: relative;
    width: min(720px, 100%);
    margin: 0;
  }

  .signature-stage {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .signature-ink {
    transform-box: fill-box;
    transform-origin: center;
  }

  .signature-ink-final {
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .signature-ink-reveal {
    opacity: 1;
  }

  .dynamic-signature.is-complete .signature-ink-final {
    opacity: 1;
  }

  .dynamic-signature.is-complete .signature-ink-reveal {
    opacity: 0;
  }

  .signature-stroke {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .signature-replay {
    position: absolute;
    right: 0;
    bottom: 2%;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.38rem 0.62rem;
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .dynamic-signature:hover .signature-replay,
  .signature-replay:focus-visible {
    opacity: 1;
  }

  .signature-replay:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  @keyframes signature-write {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-ink-final {
      opacity: 1;
      transition: none;
    }

    .signature-ink-reveal,
    .signature-replay {
      display: none;
    }
  }
</style>
