---
import { ArrowUpRight, ExternalLink, GitBranch } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="surface overflow-hidden rounded-lg transition hover:-translate-y-0.5 hover:border-[var(--accent)]">
  {
    project.data.cover && (
      <a href={`/projects/${project.id}/`} class="focus-ring block">
        <img src={project.data.cover} alt="" class="aspect-[16/9] w-full object-cover" loading="lazy" />
      </a>
    )
  }
  <div class="p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <span class="chip">{project.data.status}</span>
        <h2 class="mt-3 text-xl font-semibold">{project.data.title}</h2>
      </div>
      <a href={`/projects/${project.id}/`} class="focus-ring rounded-md p-1 text-[var(--muted)] transition hover:text-[var(--accent)]" aria-label="查看项目详情">
        <ArrowUpRight class="h-5 w-5" aria-hidden="true" />
      </a>
    </div>
    <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{project.data.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.data.stack.map((item) => <span class="chip">{item}</span>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      {
        project.data.demo && (
          <a href={project.data.demo} class="focus-ring inline-flex items-center gap-2 rounded-md border border-[var(--line)] px-3 py-2 text-sm transition hover:border-[var(--accent)]" target="_blank" rel="noreferrer">
            <ExternalLink class="h-4 w-4" aria-hidden="true" />
            Demo
          </a>
        )
      }
      {
        project.data.repo && (
          <a href={project.data.repo} class="focus-ring inline-flex items-center gap-2 rounded-md border border-[var(--line)] px-3 py-2 text-sm transition hover:border-[var(--accent)]" target="_blank" rel="noreferrer">
            <GitBranch class="h-4 w-4" aria-hidden="true" />
            Code
          </a>
        )
      }
    </div>
  </div>
</article>
