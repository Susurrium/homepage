---
import { ArrowUpRight, ExternalLink, GitBranch } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="surface group overflow-hidden rounded-lg motion-safe:transition-[transform,border-color,box-shadow] motion-safe:duration-200 motion-safe:hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-lg hover:shadow-[color-mix(in_srgb,var(--accent)_6%,transparent)]">
  {
    project.data.cover && (
      <a
        href={withBase(`/projects/${project.id}/`)}
        class="focus-ring block overflow-hidden"
        aria-label={`查看项目：${project.data.title}`}
      >
        <img src={withBase(project.data.cover)} alt="" class="aspect-[16/9] w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]" loading="lazy" />
      </a>
    )
  }
  <div class="p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <span class="chip">{project.data.status}</span>
        <h2 class="mt-3 text-xl font-semibold motion-safe:transition-colors motion-safe:duration-200 group-hover:text-[var(--accent)]">{project.data.title}</h2>
      </div>
      <a href={withBase(`/projects/${project.id}/`)} class="focus-ring rounded-md p-1 text-[var(--muted)] motion-safe:transition-[color,transform] motion-safe:duration-200 hover:text-[var(--accent)] motion-safe:hover:translate-x-0.5 motion-safe:hover:-translate-y-0.5" aria-label="查看项目详情">
        <ArrowUpRight class="h-5 w-5" aria-hidden="true" />
      </a>
    </div>
    <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{project.data.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.data.stack.map((item) => <span class="chip">{item}</span>)}
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      {
        project.data.demo && (
          <a href={project.data.demo} class="focus-ring inline-flex items-center gap-2 rounded-md border border-[var(--line)] px-3 py-2 text-sm motion-safe:transition-colors motion-safe:duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]" target="_blank" rel="noreferrer">
            <ExternalLink class="h-4 w-4" aria-hidden="true" />
            Demo
          </a>
        )
      }
      {
        project.data.repo && (
          <a href={project.data.repo} class="focus-ring inline-flex items-center gap-2 rounded-md border border-[var(--line)] px-3 py-2 text-sm motion-safe:transition-colors motion-safe:duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)]" target="_blank" rel="noreferrer">
            <GitBranch class="h-4 w-4" aria-hidden="true" />
            Code
          </a>
        )
      }
    </div>
  </div>
</article>
