---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const SVG_WIDTH = 2048;
const SVG_HEIGHT = 682;

// 笔画的书写顺序和对应的clip区域
const strokes = [
  { id: 'clip_initial_S', x: 0, y: 15, w: 730, h: 635 },
  { id: 'clip_u1', x: 500, y: 220, w: 200, h: 260 },
  { id: 'clip_s2', x: 620, y: 210, w: 240, h: 280 },
  { id: 'clip_u2', x: 780, y: 205, w: 215, h: 220 },
  { id: 'clip_r1', x: 935, y: 200, w: 170, h: 205 },
  { id: 'clip_r2', x: 1045, y: 200, w: 170, h: 205 },
  { id: 'clip_i_body', x: 1150, y: 190, w: 135, h: 220 },
  { id: 'clip_i_mark', x: 1220, y: 115, w: 155, h: 120 },
  { id: 'clip_u3', x: 1210, y: 195, w: 240, h: 225 },
  { id: 'clip_m', x: 1365, y: 195, w: 225, h: 230 },
  { id: 'clip_underline', x: 540, y: 370, w: 1090, h: 225 },
  { id: 'clip_arrow_flourish', x: 1500, y: 190, w: 485, h: 330 },
  { id: 'clip_arrow_dot', x: 1935, y: 180, w: 90, h: 65 },
];
---

<div class:list={['signature', className]}>
  <svg class="signature-svg" viewBox={`0 0 ${SVG_WIDTH} ${SVG_HEIGHT}`} preserveAspectRatio="xMidYMid meet">
    <defs>
      <!-- 蓝色到橙色渐变：从清晨蓝天到夕阳 -->
      <linearGradient id="signatureGradient" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#0ea5e9" />      <!-- 天蓝 -->
        <stop offset="30%" stop-color="#3b82f6" />     <!-- 蓝色 -->
        <stop offset="50%" stop-color="#8b5cf6" />     <!-- 紫色过渡 -->
        <stop offset="70%" stop-color="#f97316" />     <!-- 橙色 -->
        <stop offset="100%" stop-color="#ea580c" />    <!-- 深橙夕阳 -->
      </linearGradient>

      <!-- 13个clipPath，对应13个笔画区域 -->
      <clipPath id="clip_initial_S">
        <rect x="0" y="15" width="730" height="635" />
      </clipPath>
      <clipPath id="clip_u1">
        <rect x="500" y="220" width="200" height="260" />
      </clipPath>
      <clipPath id="clip_s2">
        <rect x="620" y="210" width="240" height="280" />
      </clipPath>
      <clipPath id="clip_u2">
        <rect x="780" y="205" width="215" height="220" />
      </clipPath>
      <clipPath id="clip_r1">
        <rect x="935" y="200" width="170" height="205" />
      </clipPath>
      <clipPath id="clip_r2">
        <rect x="1045" y="200" width="170" height="205" />
      </clipPath>
      <clipPath id="clip_i_body">
        <rect x="1150" y="190" width="135" height="220" />
      </clipPath>
      <clipPath id="clip_i_mark">
        <rect x="1220" y="115" width="155" height="120" />
      </clipPath>
      <clipPath id="clip_u3">
        <rect x="1210" y="195" width="240" height="225" />
      </clipPath>
      <clipPath id="clip_m">
        <rect x="1365" y="195" width="225" height="230" />
      </clipPath>
      <clipPath id="clip_underline">
        <rect x="540" y="370" width="1090" height="225" />
      </clipPath>
      <clipPath id="clip_arrow_flourish">
        <rect x="1500" y="190" width="485" height="330" />
      </clipPath>
      <clipPath id="clip_arrow_dot">
        <rect x="1935" y="180" width="90" height="65" />
      </clipPath>
    </defs>

    <!-- 13个笔画路径，使用对应的clipPath裁剪 -->
    <path id="stroke_01_initial_S" class="stroke" clip-path="url(#clip_initial_S)" />
    <path id="stroke_02_u1" class="stroke" clip-path="url(#clip_u1)" />
    <path id="stroke_03_s2" class="stroke" clip-path="url(#clip_s2)" />
    <path id="stroke_04_u2" class="stroke" clip-path="url(#clip_u2)" />
    <path id="stroke_05_r1" class="stroke" clip-path="url(#clip_r1)" />
    <path id="stroke_06_r2" class="stroke" clip-path="url(#clip_r2)" />
    <path id="stroke_07_i_body" class="stroke" clip-path="url(#clip_i_body)" />
    <path id="stroke_08_i_mark" class="stroke" clip-path="url(#clip_i_mark)" />
    <path id="stroke_09_u3" class="stroke" clip-path="url(#clip_u3)" />
    <path id="stroke_10_m" class="stroke" clip-path="url(#clip_m)" />
    <path id="stroke_11_underline" class="stroke" clip-path="url(#clip_underline)" />
    <path id="stroke_12_arrow_flourish" class="stroke" clip-path="url(#clip_arrow_flourish)" />
    <path id="stroke_13_arrow_dot" class="stroke" clip-path="url(#clip_arrow_dot)" />
  </svg>
</div>

<style>
  .signature {
    display: inline-block;
    position: relative;
    max-width: 400px;
    width: 100%;
    height: 110px;
  }

  .signature::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, transparent 49.5%, rgba(255,255,255,0.4) 49.5%, rgba(255,255,255,0.4) 50.5%, transparent 50.5%),
      linear-gradient(0deg, transparent 49.5%, rgba(255,255,255,0.4) 49.5%, rgba(255,255,255,0.4) 50.5%, transparent 50.5%);
    background-size: 10px 10px;
    opacity: 0.3;
    pointer-events: none;
    z-index: 1;
  }

  .signature-svg {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 0;
  }

  .stroke {
    fill: none;
    stroke: url(#signatureGradient);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
</style>

<script define:vars={{ SVG_WIDTH, SVG_HEIGHT }}>
  class SignatureAnimation {
    private container: HTMLElement;
    private svg: SVGSVGElement;
    private strokes: NodeListOf<SVGPathElement>;
    private pathData: string = '';
    private isLoading: boolean = false;

    constructor(container: HTMLElement) {
      this.container = container;
      this.svg = container.querySelector('.signature-svg') as SVGSVGElement;
      this.strokes = container.querySelectorAll('.stroke');
      this.init();
    }

    private async loadPathData(): Promise<string> {
      if (this.pathData) return this.pathData;

      try {
        const response = await fetch('/signature.svg');
        const text = await response.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'image/svg+xml');
        const pathEl = doc.querySelector('path');
        if (pathEl) {
          this.pathData = pathEl.getAttribute('d') || '';
        }
      } catch (e) {
        console.error('Failed to load signature path data:', e);
      }
      return this.pathData;
    }

    private async init() {
      this.pathData = await this.loadPathData();
      if (this.pathData) {
        this.setPathData();
        this.startLoop();
      }
    }

    private setPathData() {
      this.strokes.forEach((stroke) => {
        stroke.setAttribute('d', this.pathData);
      });
    }

    private async startLoop() {
      while (true) {
        await this.animate();
        await this.wait(2000);
        await this.fadeOut();
        await this.wait(1000);
        this.reset();
        await this.wait(500);
      }
    }

    private async animate(): Promise<void> {
      const duration = 4000;
      const totalStrokes = this.strokes.length;
      const strokeDuration = duration / totalStrokes;

      for (let i = 0; i < totalStrokes; i++) {
        const stroke = this.strokes[i];
        stroke.style.strokeDashoffset = '1000';

        await this.wait(strokeDuration * i);

        stroke.style.transition = `stroke-dashoffset ${strokeDuration}ms ease-out`;
        stroke.style.strokeDashoffset = '0';
      }

      await this.wait(strokeDuration);
    }

    private async fadeOut(): Promise<void> {
      return new Promise((resolve) => {
        this.container.style.transition = 'opacity 1000ms ease-in';
        this.container.style.opacity = '0';
        setTimeout(resolve, 1000);
      });
    }

    private reset() {
      this.container.style.transition = 'none';
      this.container.style.opacity = '1';
      this.strokes.forEach((stroke) => {
        stroke.style.transition = 'none';
        stroke.style.strokeDashoffset = '1000';
      });
    }

    private wait(ms: number): Promise<void> {
      return new Promise(resolve => setTimeout(resolve, ms));
    }
  }

  function initSignatures() {
    document.querySelectorAll('.signature').forEach((el) => {
      new SignatureAnimation(el as HTMLElement);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSignatures);
  } else {
    initSignatures();
  }
</script>