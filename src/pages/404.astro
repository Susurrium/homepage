---
import { ArrowLeft, Search } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在、已移动或地址有误。" noindex>
  <section class="page-wrap flex min-h-[62vh] items-center py-16" data-pagefind-ignore="all">
    <div class="surface w-full overflow-hidden rounded-lg p-7 sm:p-10">
      <p class="text-sm font-medium tracking-[0.24em] text-[var(--accent)]">404</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-semibold tracking-normal sm:text-5xl">这页暂时找不到</h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-[var(--muted)]">
        页面可能已经移动，也可能是地址中多了一个字符。你可以返回首页，或者搜索站内内容。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={withBase('/')}
          class="focus-ring inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--text)] px-5 py-2.5 text-sm font-medium text-[var(--bg)] transition hover:opacity-85"
        >
          <ArrowLeft class="h-4 w-4" aria-hidden="true" />
          返回首页
        </a>
        <a
          href={withBase('/search/')}
          class="focus-ring inline-flex min-h-11 items-center gap-2 rounded-md border border-[var(--line)] bg-[var(--surface)] px-5 py-2.5 text-sm font-medium transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >
          <Search class="h-4 w-4" aria-hidden="true" />
          搜索内容
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
