---
import { ArrowLeft } from '@lucide/astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, published, readingTime, sortByDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = published(await getCollection('blog'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const posts = sortByDate(published(await getCollection('blog')));
const index = posts.findIndex((item) => item.id === post.id);
const prev = posts[index + 1];
const next = posts[index - 1];
const toc = headings.filter((heading) => heading.depth < 4);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" image={post.data.hero ?? '/images/og.svg'}>
  <article class="page-wrap grid gap-10 pb-16 pt-10 lg:grid-cols-[minmax(0,1fr)_260px]">
    <div class="min-w-0 animate-fade-up">
      <a href="/blog/" class="focus-ring inline-flex items-center gap-2 rounded-md text-sm text-[var(--muted)] transition hover:text-[var(--accent)]">
        <ArrowLeft class="h-4 w-4" aria-hidden="true" />
        返回博客
      </a>
      <header class="mt-8">
        <div class="flex flex-wrap gap-2">
          <span class="chip !border-[var(--accent)] !bg-[color-mix(in_srgb,var(--accent)_8%,transparent)] !text-[var(--accent)]">{post.data.category}</span>
          {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`} class="chip hover:!border-[var(--accent)]">#{tag}</a>)}
        </div>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-normal sm:text-5xl">{post.data.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)]">{post.data.description}</p>
        <p class="mt-5 text-sm text-[var(--muted)]">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span> · </span>
          <span>{readingTime(post.body)}</span>
        </p>
      </header>

      {
        post.data.hero && (
          <img src={post.data.hero} alt="" class="mt-8 aspect-[16/9] w-full rounded-lg border border-[var(--line)] object-cover" />
        )
      }

      <div class="prose mt-10 max-w-none">
        <Content />
      </div>

      <nav class="mt-12 grid gap-3 border-t border-[var(--line)] pt-8 sm:grid-cols-2" aria-label="上一篇和下一篇文章">
        {
          prev && (
            <a href={`/blog/${prev.id}/`} class="focus-ring surface rounded-lg p-4 transition hover:border-[var(--accent)]">
              <span class="text-sm text-[var(--muted)]">上一篇</span>
              <span class="mt-1 block font-medium">{prev.data.title}</span>
            </a>
          )
        }
        {
          next && (
            <a href={`/blog/${next.id}/`} class="focus-ring surface rounded-lg p-4 transition hover:border-[var(--accent)] sm:text-right">
              <span class="text-sm text-[var(--muted)]">下一篇</span>
              <span class="mt-1 block font-medium">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-24 rounded-lg border border-[var(--line)] bg-[var(--surface)] p-4">
        <p class="text-sm font-medium">目录</p>
        <nav class="mt-3 grid gap-2 text-sm text-[var(--muted)]" aria-label="文章目录">
          {
            toc.map((heading) => (
                <a href={`#${heading.slug}`} class:list={['link-underline inline-block w-fit transition hover:text-[var(--accent)]', heading.depth === 3 && 'pl-3']}>
                  {heading.text}
                </a>
              ))
          }
        </nav>
      </div>
    </aside>
  </article>
</BaseLayout>