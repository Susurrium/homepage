---
import { ArrowLeft } from '@lucide/astro';
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleEnhancements from '../../components/ArticleEnhancements.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, published, readingTime, sortByDate, tagPathSegment } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = published(await getCollection('blog'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = sortByDate(published(await getCollection('blog')));
const index = posts.findIndex((item) => item.id === post.id);
const prev = posts[index + 1];
const next = posts[index - 1];
const toc = headings.filter((heading) => heading.depth < 4);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={post.data.hero ?? '/images/og.png'}
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
>
  <ArticleEnhancements />
  <article
    class:list={[
      'page-wrap grid gap-10 pb-16 pt-10',
      toc.length > 0 && 'lg:grid-cols-[minmax(0,1fr)_260px]'
    ]}
    data-article-root
  >
    <div class="min-w-0 animate-fade-up">
      <a href={withBase('/blog/')} class="focus-ring inline-flex items-center gap-2 rounded-md text-sm text-[var(--muted)] transition hover:text-[var(--accent)]">
        <ArrowLeft class="h-4 w-4" aria-hidden="true" />
        返回博客
      </a>
      <header class="mt-8">
        <div class="flex flex-wrap gap-2">
          <span class="chip border-[var(--accent)] bg-[color-mix(in_srgb,var(--accent)_8%,transparent)] text-[var(--accent)]">{post.data.category}</span>
          {post.data.tags.map((tag) => <a href={withBase(`/tags/${tagPathSegment(tag)}/`)} class="chip hover:border-[var(--accent)]">#{tag}</a>)}
        </div>
        <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-normal sm:text-5xl">{post.data.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)]">{post.data.description}</p>
        <p class="mt-5 text-sm text-[var(--muted)]">
          <span>发布于 <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
          {
            post.data.updated && (
              <>
                <span aria-hidden="true"> · </span>
                <span>更新于 <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></span>
              </>
            )
          }
          <span> · </span>
          <span>{readingTime(post.body)}</span>
        </p>
      </header>

      {
        post.data.hero && (
          <Image
            src={post.data.hero.src}
            alt={post.data.hero.alt}
            width={post.data.hero.src.width}
            height={post.data.hero.src.height}
            class="mt-8 aspect-[16/9] w-full rounded-lg border border-[var(--line)] object-cover"
            style={post.data.hero.color ? `background-color: ${post.data.hero.color}` : undefined}
            data-article-image
          />
        )
      }

      <ArticleToc headings={toc} variant="mobile" />

      <div class="prose mt-10 max-w-none" data-article-content>
        <Content />
      </div>

      <nav class="mt-12 grid gap-3 border-t border-[var(--line)] pt-8 sm:grid-cols-2" aria-label="上一篇和下一篇文章">
        {
          prev && (
            <a href={withBase(`/blog/${prev.id}/`)} class="focus-ring surface rounded-lg p-4 transition hover:border-[var(--accent)]">
              <span class="text-sm text-[var(--muted)]">上一篇</span>
              <span class="mt-1 block font-medium">{prev.data.title}</span>
            </a>
          )
        }
        {
          next && (
            <a href={withBase(`/blog/${next.id}/`)} class="focus-ring surface rounded-lg p-4 transition hover:border-[var(--accent)] sm:text-right">
              <span class="text-sm text-[var(--muted)]">下一篇</span>
              <span class="mt-1 block font-medium">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>

    {
      toc.length > 0 && (
        <aside class="hidden lg:block" aria-label="文章页侧栏">
          <ArticleToc headings={toc} variant="desktop" />
        </aside>
      )
    }
  </article>
</BaseLayout>
