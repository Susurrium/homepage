---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageHero from '../../../components/PageHero.astro';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { allTags, pageCount, paginate, published, sortByDate, tagPathSegment } from '../../../lib/content';
import { withBase } from '../../../lib/url';

interface Props {
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  tags: ReturnType<typeof allTags>;
}

export async function getStaticPaths() {
  const posts = sortByDate(published(await getCollection('blog')));
  const totalPages = pageCount(posts.length);
  const tags = allTags(posts);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const page = paginate(posts, currentPage);

    return {
      params: { page: String(currentPage) },
      props: { posts: page.items, currentPage, totalPages, tags }
    };
  });
}

const { posts, currentPage, totalPages, tags } = Astro.props;
---

<BaseLayout title={`博客 · 第 ${currentPage} 页`} description={`技术笔记、项目复盘、阅读记录与长期写作，第 ${currentPage} 页。`}>
  <PageHero eyebrow="Blog" title="博客" description={`全部文章 · 第 ${currentPage} / ${totalPages} 页`} />

  <section class="page-wrap pb-16">
    <div class="mb-6 flex flex-wrap items-center gap-2">
      {tags.map((tag) => <a href={withBase(`/tags/${tagPathSegment(tag.name)}/`)} class="focus-ring chip hover:border-[var(--accent)]">#{tag.name} {tag.count}</a>)}
      <a href={withBase('/tags/')} class="focus-ring chip hover:border-[var(--accent)]">全部标签</a>
      <a href={withBase('/archives/')} class="focus-ring chip hover:border-[var(--accent)]">年度归档</a>
    </div>

    <div class="grid gap-4">
      {posts.map((post, index) => (
        <div class="reveal" style={`transition-delay: ${(index + 1) * 60}ms`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/blog" />
  </section>
</BaseLayout>
