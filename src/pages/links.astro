---
import { ArrowUpRight } from '@lucide/astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="友链" description="常用工具、朋友站点和推荐资源。">
  <PageHero eyebrow="Links" title="友链与资源" description="用于构建本站，以及值得长期关注的工具与平台。" />

  <section class="page-wrap grid gap-4 pb-16 md:grid-cols-2">
    {
      site.links.map((link, index) => (
        <div class="reveal" style={`transition-delay: ${(index + 1) * 60}ms`}>
          <a href={link.href} class="surface focus-ring group block h-full rounded-lg p-5 motion-safe:transition-[transform,border-color,box-shadow] motion-safe:duration-200 motion-safe:hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-lg hover:shadow-[color-mix(in_srgb,var(--accent)_6%,transparent)]" target="_blank" rel="noreferrer">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-semibold motion-safe:transition-colors motion-safe:duration-200 group-hover:text-[var(--accent)]">{link.name}</h2>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{link.description}</p>
              </div>
              <ArrowUpRight class="mt-1 h-5 w-5 shrink-0 text-[var(--muted)] motion-safe:transition-[color,transform] motion-safe:duration-200 group-hover:text-[var(--accent)] motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" aria-hidden="true" />
            </div>
          </a>
        </div>
      ))
    }
  </section>
</BaseLayout>
