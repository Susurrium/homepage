---
import { ArrowUpRight } from '@lucide/astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="友链" description="常用工具、朋友站点和推荐资源。">
  <PageHero eyebrow="Links" title="友链与资源" description="这里可以放朋友的博客、常用工具、学习资源和你想长期推荐的网站。" />

  <section class="page-wrap grid gap-4 pb-16 md:grid-cols-2">
    {
      site.links.map((link) => (
        <a href={link.href} class="surface focus-ring group rounded-lg p-5 transition hover:-translate-y-0.5 hover:border-[var(--accent)]" target="_blank" rel="noreferrer">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold">{link.name}</h2>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{link.description}</p>
            </div>
            <ArrowUpRight class="h-5 w-5 shrink-0 text-[var(--muted)] transition group-hover:text-[var(--accent)]" aria-hidden="true" />
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>
