---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageHero from '../../../../components/PageHero.astro';
import Pagination from '../../../../components/Pagination.astro';
import PostCard from '../../../../components/PostCard.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { allTags, pageCount, paginate, published, sortByDate, tagPathSegment, tagSlug } from '../../../../lib/content';
import { withBase } from '../../../../lib/url';

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

export async function getStaticPaths() {
  const posts = sortByDate(published(await getCollection('blog')));

  return allTags(posts).flatMap((tag) => {
    const taggedPosts = posts.filter((post) =>
      post.data.tags.some((postTag) => tagSlug(postTag) === tagSlug(tag.name))
    );
    const totalPages = pageCount(taggedPosts.length);

    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const currentPage = index + 2;
      const page = paginate(taggedPosts, currentPage);

      return {
        params: { tag: tagSlug(tag.name), page: String(currentPage) },
        props: {
          tag: tag.name,
          posts: page.items,
          currentPage,
          totalPages,
          totalPosts: page.totalItems
        }
      };
    });
  });
}

const { tag, posts, currentPage, totalPages, totalPosts } = Astro.props;
const tagBasePath = `/tags/${tagPathSegment(tag)}`;
---

<BaseLayout title={`标签：${tag} · 第 ${currentPage} 页`} description={`浏览标签 ${tag} 下的文章，第 ${currentPage} 页。`}>
  <PageHero eyebrow="Tag" title={`#${tag}`} description={`${totalPosts} 篇文章 · 第 ${currentPage} / ${totalPages} 页`} />
  <section class="page-wrap pb-16">
    <div class="mb-6 flex flex-wrap gap-2">
      <a href={withBase('/tags/')} class="focus-ring chip hover:border-[var(--accent)]">全部标签</a>
      <a href={withBase('/archives/')} class="focus-ring chip hover:border-[var(--accent)]">年度归档</a>
    </div>
    <div class="grid gap-4">
      {posts.map((post, index) => (
        <div class="reveal" style={`transition-delay: ${(index + 1) * 60}ms`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={tagBasePath} label={`${tag} 标签文章分页`} />
  </section>
</BaseLayout>
