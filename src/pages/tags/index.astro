---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags, published } from '../../lib/content';
import { withBase } from '../../lib/url';

const tags = allTags(published(await getCollection('blog')));
---

<BaseLayout title="标签" description="博客文章标签索引。">
  <PageHero eyebrow="Tags" title="标签" description="按主题浏览文章。" />
  <section class="page-wrap flex flex-wrap gap-3 pb-16">
    {tags.length > 0 ? (
      tags.map((tag, index) => <a href={withBase(`/tags/${encodeURIComponent(tag.name)}/`)} class="reveal chip hover:border-[var(--accent)]" style={`transition-delay: ${(index + 1) * 40}ms`}>#{tag.name} {tag.count}</a>)
    ) : (
      <p class="surface w-full rounded-lg p-5 text-sm text-[var(--muted)]">暂无文章标签。</p>
    )}
  </section>
</BaseLayout>
